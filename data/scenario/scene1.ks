[_tb_system_call storage=system/_scene1.ks]

[call  storage="common_ui.ks"  target="*init"  ]
[cm  ]
[playbgm  volume="100"  time="1000"  loop="true"  storage="amenisuteraretaningyou.mp3"  fadein="true"  ]
[bg  time="3000"  method="fadeIn"  storage="死体発見.webp"  ]
[tb_image_show  time="1000"  storage="default/死体.webp"  width="505"  height="357"  x="375"  y="108"  name="img_3"  ]
[playse  volume="100"  time="1000"  buf="0"  storage="不気味な出現音2.mp3"  ]
[wait  time="3000"  ]
[tb_show_message_window  ]
[font  size="28"  color="0xfa0000"  bold="true"  ]
[tb_start_text mode=1 ]
#ナゾA
う、うわああぁぁああぁああぁぁぁ！！！！[p]
[_tb_end_text]

[tb_hide_message_window  ]
[wait  time="2000"  ]
[stopbgm  time="4000"  fadeout="true"  ]
[tb_image_hide  time="1000"  ]
[mask  time="2000"  effect="fadeIn"  color="0x000000"  ]
[jump  storage="scene2.ks"  target=""  ]
